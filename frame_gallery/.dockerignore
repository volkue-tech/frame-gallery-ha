# The build context is an allowlist. The app image copies only
# src/frame_gallery and the requirement files; the test stage copies the rest,
# so that the tests find the files they check.
*
!Dockerfile
!Dockerfile.release
!.dockerignore
!pyproject.toml
!uv.lock
!requirements/
!license_bundle/
!src/frame_gallery/
!tests/
!scripts/
!assets/brand/
!examples/
!config.yaml
!translations/
!apparmor.txt
!icon.png
!logo.png
!DOCS.md
!ARTWORK_INFO.md
!COMMONS.md
!COMMONS_400_ARCHIVE.md
!COMMONS_COLOUR.md
!COMMONS_COLOUR.de.md
!COMMONS_COLOUR.fr.md
!COMMONS_COLOUR.es.md
!SETUP.fr.md
!SETUP.es.md
!research/
!README.md
!CHANGELOG.md
!VOCABULARY.md
!DEVELOPMENT.md
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.coverage*
